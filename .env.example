# ─── Database (Neon Postgres) ─────────────────────────────────────────────
# Use sslmode=verify-full, NOT sslmode=require: `require` still means
# verify-full in pg 8 but logs a deprecation warning, and in pg 9 it will
# silently downgrade to weaker libpq semantics.
#
# Pooled connection string (used by the app at runtime).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/ren?sslmode=verify-full"
# Direct (non-pooled) connection — used by Prisma Migrate. Keep this on the
# non-pooled host: PgBouncer can't hold the advisory locks migrate needs.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/ren?sslmode=verify-full"

# ─── Clerk (app authentication — NOT platform posting) ────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ─── Groq (AI drafting + critique) ────────────────────────────────────────
GROQ_API_KEY="gsk_..."
# Model routing (separate per-model rate-limit pools — keep configurable).
# Prefer models that support Groq's `json_schema` response format (the gpt-oss
# family does; llama/qwen/compound only do plain JSON mode). Others still work
# — lib/ai/groq.ts falls back to prompt-injected JSON mode — but less reliably.
GROQ_MODEL_PRIMARY="openai/gpt-oss-120b"
GROQ_MODEL_LIGHT="openai/gpt-oss-20b"

# ─── OAuth token encryption (AES-256-GCM) ─────────────────────────────────
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_ENC_KEY="base64:CHANGE_ME_32_BYTES"

# ─── LinkedIn OAuth (Phase 2) ─────────────────────────────────────────────
# Create an app in the LinkedIn Developer Portal, add the "Sign In with
# LinkedIn using OpenID Connect" + "Share on LinkedIn" products, and set the
# redirect URI below as an authorized redirect URL.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/oauth/linkedin/callback"
# LinkedIn versions its REST API by month (YYYYMM) and only accepts versions
# within a rolling ~12-month window (an out-of-window value returns HTTP 426).
# Set this to a currently-supported version — the exact list is shown in your
# app's page in the LinkedIn Developer Portal. Defaults to 202606 if unset.
LINKEDIN_API_VERSION="202606"

# ─── LangSmith (LLM observability — optional) ─────────────────────────────
# When enabled, LangGraph auto-traces the multi-agent graph (each node as a
# run) and our Groq calls appear as nested `llm` runs with token usage. Fully
# no-op if LANGSMITH_TRACING is off or the key is unset (see lib/ai/
# observability/langsmith.ts). Create a key at https://smith.langchain.com.
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ren"

# ─── Tavily (live web search for the Researcher agent — optional) ─────────
# When set, the Researcher gains a `webSearch` tool to ground posts in current
# facts; results become citations. No key → the tool is simply not offered and
# grounding falls back to the local index. Get a key at https://tavily.com.
TAVILY_API_KEY=""

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
