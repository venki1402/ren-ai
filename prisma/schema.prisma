// Ren — Prisma schema (Postgres via Neon)
// Mirrors doc Section 4. Key rules:
//   - Every regenerate creates a NEW versioned `Draft` row (never overwrite).
//   - Every rejection is logged as a PostEvent with a retryReason.
//   - OAuth tokens are stored ENCRYPTED (AES-256-GCM, see lib/crypto.ts).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // manage the pgvector extension
}

// Prisma 7: connection URLs live in prisma.config.ts (used by the CLI for
// migrations/introspection). The runtime client connects via a driver
// adapter (@prisma/adapter-pg) — see lib/db.ts.
datasource db {
  provider   = "postgresql"
  extensions = [vector] // pgvector, for embeddings (RAG). Neon supports it.
}

enum Platform {
  linkedin
  x
}

enum IdeaSource {
  manual
  news
}

enum IdeaStatus {
  draft
  finalized
  archived
}

enum DraftStatus {
  generated
  critiqued
  rewritten
  approved
  rejected
  posted
}

enum PostAction {
  posted
  retry
  discarded
}

enum RetryReason {
  too_salesy
  weak_hook
  not_authentic
  other
}

// Mirrors lib/persona-shared.ts PERSONAS exactly (like Platform ↔ lib/platforms).
enum Persona {
  student
  developer
  entrepreneur
  generalist
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique @map("clerk_user_id")
  email       String
  name        String?
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")

  // Identity signal for generation (doc Section 5 — persona-conditioned drafting).
  // persona is a coarse voice prior; personaContext is optional freeform detail.
  // onboardedAt gates the (skippable) onboarding step — null = not shown yet.
  persona        Persona   @default(generalist)
  personaContext Json?     @map("persona_context")
  onboardedAt    DateTime? @map("onboarded_at")

  oauthConnections OauthConnection[]
  ideas            Idea[]
  postEmbeddings   PostEmbedding[]

  @@map("users")
}

model OauthConnection {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  platform     Platform
  accessToken  String   @map("access_token") // encrypted at rest
  refreshToken String?  @map("refresh_token") // encrypted at rest
  expiresAt    DateTime? @map("expires_at")
  scopes       String[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("oauth_connections")
}

model Idea {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  source      IdeaSource
  seedText    String     @map("seed_text")
  seedNewsUrl String?    @map("seed_news_url")
  status      IdeaStatus @default(draft)
  createdAt   DateTime   @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts Draft[]

  @@index([userId])
  @@map("ideas")
}

model Draft {
  id        String      @id @default(cuid())
  ideaId    String      @map("idea_id")
  version   Int
  status    DraftStatus @default(generated)
  createdAt DateTime    @default(now()) @map("created_at")

  idea             Idea             @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  platformVariants PlatformVariant[]

  @@unique([ideaId, version])
  @@index([ideaId])
  @@map("drafts")
}

model PlatformVariant {
  id               String   @id @default(cuid())
  draftId          String   @map("draft_id")
  platform         Platform
  content          String // the chosen full draft for this platform
  hookAlternatives Json?    @map("hook_alternatives") // 2-3 candidate hooks (Section 5.3)
  score            Json? // rubric: hook_strength, clarity, authenticity, cta_presence, formatting_fit
  critiqueNotes    String?  @map("critique_notes")
  citations        Json?    @map("citations") // grounding sources (v2 pipeline)
  createdAt        DateTime @default(now()) @map("created_at")

  draft         Draft          @relation(fields: [draftId], references: [id], onDelete: Cascade)
  postEvents    PostEvent[]
  postEmbedding PostEmbedding?

  @@index([draftId])
  @@map("platform_variants")
}

model PostEvent {
  id                String       @id @default(cuid())
  platformVariantId String       @map("platform_variant_id")
  action            PostAction
  retryReason       RetryReason? @map("retry_reason")
  retryInstruction  String?      @map("retry_instruction") // freeform "change this" note
  externalPostId    String?      @map("external_post_id")
  externalPostUrl   String?      @map("external_post_url")
  createdAt         DateTime     @default(now()) @map("created_at")

  platformVariant PlatformVariant @relation(fields: [platformVariantId], references: [id], onDelete: Cascade)

  @@index([platformVariantId])
  @@map("post_events")
}

model NewsCache {
  id        String   @id @default(cuid())
  category  String
  headline  String
  sourceUrl String   @map("source_url")
  summary   String?
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@index([category])
  @@map("news_cache")
}

// ─── RAG (retrieval-augmented generation) ──────────────────────────────────
// Two indexes, both keyed by a vector(384) embedding (all-MiniLM-L6-v2):
//   - PostEmbedding: the user's OWN accepted/posted posts → voice few-shot.
//   - DocumentChunk: chunked source material (news article text) → grounding.
// The `embedding` columns are Unsupported() because Prisma has no vector type;
// they are written and queried with raw SQL (see lib/ai/retrieval.ts). HNSW
// cosine indexes are added in the migration.

model PostEmbedding {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  platformVariantId String   @unique @map("platform_variant_id")
  platform          Platform
  content           String // the post text, kept for few-shot rendering
  score             Float? // overall rubric score at accept time (for ranking)
  embedding         Unsupported("vector(384)")
  createdAt         DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformVariant PlatformVariant @relation(fields: [platformVariantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("post_embeddings")
}

model DocumentChunk {
  id         String   @id @default(cuid())
  sourceUrl  String   @map("source_url")
  title      String?
  chunkIndex Int      @map("chunk_index")
  content    String
  embedding  Unsupported("vector(384)")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([sourceUrl])
  @@map("document_chunks")
}

// ─── Observability (LLM tracing) ───────────────────────────────────────────
// A Trace is one logical run (e.g. generating a draft for an idea). Spans are
// the nested steps within it — each LLM call, agent, tool, or retrieval — so a
// full generation renders as a tree with token/cost/latency at every node.
// Writes are best-effort and must never break generation.

model Trace {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  ideaId    String?   @map("idea_id")
  name      String // e.g. "generate:idea" | "retry:x" | "eval:run"
  status    String    @default("running") // running | ok | error
  metadata  Json?
  costUsd   Decimal?  @map("cost_usd") @db.Decimal(12, 6) // rolled up from spans
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  spans Span[]

  @@index([userId])
  @@index([ideaId])
  @@index([name])
  @@map("traces")
}

model Span {
  id       String  @id @default(cuid())
  traceId  String  @map("trace_id")
  parentId String? @map("parent_id") // nesting: agent → its LLM/tool calls

  name String // "plan" | "draft" | "critique" | "agent:researcher" | "retrieve:voice"
  kind String // llm | agent | tool | retrieval | embedding | function

  model            String?
  tier             String?
  inputTokens      Int?     @map("input_tokens")
  outputTokens     Int?     @map("output_tokens")
  totalTokens      Int?     @map("total_tokens")
  costUsd          Decimal? @map("cost_usd") @db.Decimal(12, 6)
  latencyMs        Int?     @map("latency_ms")
  status           String   @default("ok") // ok | error
  error            String?
  input            Json? // truncated prompt/args for replay + debugging
  output           Json? // truncated result
  metadata         Json?
  startedAt        DateTime  @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")

  trace Trace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([traceId])
  @@index([parentId])
  @@map("spans")
}
